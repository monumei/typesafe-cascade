{
  "name": "typesafe-cascade",
  "version": "1.0.0",
  "description": "Typed System 1 → System 2 cascade: answer with TypeSafe Jev when it is confident, escalate to a reasoning model when it is not.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/monumei/typesafe-cascade"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run src/demo.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "eval:fetch": "bun eval/fetch.ts",
    "eval:run": "bun eval/run.ts",
    "eval:report": "bun eval/report.ts",
    "eval:sample": "bun eval/fetch.ts --refresh"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  },
  "patchedDependencies": {
    "@typesafe-ai/sdk@0.7.0": "patches/@typesafe-ai%2Fsdk@0.7.0.patch"
  }
}
